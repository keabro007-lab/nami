-- ==================== 4. MACRO MULTI-PART LOGIC ====================
local partsList = {}
local selectedPartIndex = nil
local selectedMacroFile = nil
local isRecording = false
local currentPartFrames = {}
local recordConn = nil
local playSpeedMode = 1 -- 1 = 1x, 2 = 1.3x, 3 = 1.5x
local actualSpeed = 1
local isLooping = false

local isPlaying = false
local isPaused = false
local currentIndex = 1
local loadedPath = {}

