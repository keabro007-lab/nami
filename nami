local function updatePartList()
    for _, child in ipairs(PartListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local yPos = 0
    for i, p in ipairs(partsList) do
        local btn = Instance.new("TextButton", PartListFrame)
        btn.Size = UDim2.new(1, -6, 0, 24)
        btn.Position = UDim2.new(0, 3, 0, yPos)
        btn.BackgroundColor3 = (selectedPartIndex == i) and Color3.fromRGB(0, 120, 60) or Color3.fromRGB(30, 30, 40)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Text = "📁 " .. p.name .. " (" .. #p.frames .. " frames)"
        btn.TextSize = 9
        btn.Font = Enum.Font.Gotham
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        
        btn.MouseButton1Click:Connect(function()
            selectedPartIndex = i
            StatusTxt.Text = "Selected Part: " .. p.name
            updatePartList()
        end)
        
        yPos = yPos + 28
    end
    PartListFrame.CanvasSize = UDim2.new(0, 0, 0, yPos)
end

local function updateFinalMacroList()
    for _, child in ipairs(MacroListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    if not listfiles then return end
    local files = {}
    pcall(function()
        for _, file in ipairs(listfiles(FolderName)) do
            if file:sub(-5) == ".json" then
                local name = file:match("([^/]+)$"):gsub("%.json$", "")
                table.insert(files, name)
            end
        end
    end)
    
    local yPos = 0
    for _, name in ipairs(files) do
        local btn = Instance.new("TextButton", MacroListFrame)
        btn.Size = UDim2.new(1, -6, 0, 22)
        btn.Position = UDim2.new(0, 3, 0, yPos)
        btn.BackgroundColor3 = (selectedMacroFile == name) and Color3.fromRGB(0, 100, 160) or Color3.fromRGB(25, 25, 35)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Text = "📄 " .. name
        btn.TextSize = 8
        btn.Font = Enum.Font.Gotham
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        
        btn.MouseButton1Click:Connect(function()
            selectedMacroFile = name
            StatusTxt.Text = "Selected File to Play: " .. name
            isPlaying = false
            isPaused = false
            currentIndex = 1
            PlayBtn.Text = "▶️ Play"
            PlayBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 160)
            updateFinalMacroList()
        end)
        
        yPos = yPos + 25
    end
    MacroListFrame.CanvasSize = UDim2.new(0, 0, 0, yPos)
end

RecordBtn.MouseButton1Click:Connect(function()
    if not isRecording then
        currentPartFrames = {}
        isRecording = true
        
        local nextNum = #partsList + 1
        RecordBtn.Text = "⏹️ Stop & Save Part " .. nextNum
        RecordBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 0)
        StatusTxt.Text = "Status: Recording Part " .. nextNum .."..."
        
        if recordConn then recordConn:Disconnect() end
        recordConn = RunService.Heartbeat:Connect(function()
            if isRecording then
                pcall(function()
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local cf = char.HumanoidRootPart.CFrame
                        table.insert(currentPartFrames, {cf:GetComponents()})
                    end
                end)
            end
        end)
    else
        if #currentPartFrames > 0 then
            local partNum = #partsList + 1
            table.insert(partsList, {
                name = "Part " .. partNum,
                frames = currentPartFrames
            })
            currentPartFrames = {}
            updatePartList()
        end
        
        local nextNum = #partsList + 1
        RecordBtn.Text = "🔴 Record Next Part (" .. nextNum .. ")"
        RecordBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        StatusTxt.Text = "Status: Part saved successfully!"
        isRecording = false
        if recordConn then recordConn:Disconnect() end
    end
end)

DeletePartBtn.MouseButton1Click:Connect(function()
    if not selectedPartIndex then
        StatusTxt.Text = "Status: Please select a Part from the list to delete!"
        return
    end
    
    local pName = partsList[selectedPartIndex].name
    table.remove(partsList, selectedPartIndex)
    selectedPartIndex = nil
    updatePartList()
    StatusTxt.Text = "Status: Deleted " .. pName .. " successfully!"
end)

SaveAllBtn.MouseButton1Click:Connect(function()
    if #partsList == 0 then
        StatusTxt.Text = "Status: No parts recorded to save!"
        return
    end
    
    local macroName = NameBox.Text
    if macroName == "" or macroName == "Enter File Name (e.g. Farm1, Farm2)..." then
        macroName = "Macro_" .. (os.time() % 1000)
    end
    
    local combinedFrames = {}
    for _, part in ipairs(partsList) do
        for _, frame in ipairs(part.frames) do
            table.insert(combinedFrames, frame)
        end
    end
    
    if #combinedFrames > 0 and writefile then
        pcall(function()
            local encoded = HttpService:JSONEncode(combinedFrames)
            writefile(FolderName .. "/" .. macroName .. ".json", encoded)
            selectedMacroFile = macroName
            StatusTxt.Text = "Successfully saved '" .. macroName .. "'!"
            
            partsList = {}
            updatePartList()
            updateFinalMacroList()
        end)
    else
        StatusTxt.Text = "Status: Error writing file!"
    end
end)

DeleteMacroBtn.MouseButton1Click:Connect(function()
    if not selectedMacroFile or not delfile then
        StatusTxt.Text = "Status: No final file selected!"
        return
    end
    
    pcall(function()
        delfile(FolderName .. "/" .. selectedMacroFile .. ".json")
        StatusTxt.Text = "Deleted file '" .. selectedMacroFile .. "'!"
        selectedMacroFile = nil
        isPlaying = false
        isPaused = false
        PlayBtn.Text = "▶️ Play"
        PlayBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 160)
        updateFinalMacroList()
    end)
end)

-- Play Button Logic with Infinite Loop Support
PlayBtn.MouseButton1Click:Connect(function()
    if not selectedMacroFile or not readfile then
        StatusTxt.Text = "Status: Please select a file from the list below first!"
        return
    end

    if isPlaying and not isPaused then
        isPaused = true
        PlayBtn.Text = "▶️ Resume"
        PlayBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 0)
        StatusTxt.Text = "Status: Paused at frame " .. currentIndex
        return
    end

    if isPlaying and isPaused then
        isPaused = false
        PlayBtn.Text = "⏸️ Pause"
        PlayBtn.BackgroundColor3 = Color3.fromRGB(160, 90, 0)
        StatusTxt.Text = "Status: Resumed playing..."
        return
    end

    local filePath = FolderName .. "/" .. selectedMacroFile .. ".json"
    local success, result = pcall(function()
        return readfile(filePath)
    end)
    
    if not success or not result then
        StatusTxt.Text = "Status: File not found!"
        return
    end

    pcall(function()
        loadedPath = HttpService:JSONDecode(result)
    end)

    if not loadedPath or #loadedPath == 0 then
        StatusTxt.Text = "Status: Macro file is empty!"
        return
    end

    isPlaying = true
    isPaused = false
    currentIndex = 1
    PlayBtn.Text = "⏸️ Pause"
    PlayBtn.BackgroundColor3 = Color3.fromRGB(160, 90, 0)
    StatusTxt.Text = "Status: Playing '" .. selectedMacroFile .. "'..."

    task.spawn(function()
        pcall(function()
            while isPlaying do
                while currentIndex <= #loadedPath do
                    while isPaused do
                        task.wait(0.1)
                        if not isPlaying then break end
                    end

                    if not isPlaying then break end

                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    
                    if hrp then
                        local step = 1
                        if actualSpeed == 1.3 then
                            step = (currentIndex % 3 == 0) and 2 or 1
                        elseif actualSpeed == 1.5 then
                            step = 2
                        end
                        
                        hrp.CFrame = CFrame.new(table.unpack(loadedPath[currentIndex]))
                        currentIndex = currentIndex + step
                    end
                    
                    task.wait(0.03 / actualSpeed)
                end

                -- Check if loop is enabled
                if isLooping and isPlaying then
                    currentIndex = 1 -- Reset to start for looping
                    StatusTxt.Text = "Status: Loop restarting '" .. selectedMacroFile .. "'..."
                    task.wait(0.5) -- Small breathing pause before looping again
                else
                    break -- Exit loop if Loop is OFF
                end
            end

            isPlaying = false
            isPaused = false
            currentIndex = 1
            PlayBtn.Text = "▶️ Play"
            PlayBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 160)
            StatusTxt.Text = "Status: Playback finished!"
        end)
    end)
end)

