    else
        playSpeed = 1
        SpeedBtn.Text = "⚡ Play Speed: 1x (Normal)"
    end
end)

-- Function to load & update list of saved files from device
local function updateFileList()
    for _, child in ipairs(MacroListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    if not listfiles then return end
    local files = {}
    pcall(function()
        for _, file in ipairs(listfiles(FolderName)) do
            if file:sub(-5) == ".json" then
                local name = file:match("([^/]+)$"):gsub("%.json$", "")
                table.insert(files, name)
            end
        end
    end)
    
    local yPos = 0
    for _, name in ipairs(files) do
        local btn = Instance.new("TextButton", MacroListFrame)
        btn.Size = UDim2.new(1, -6, 0, 26)
        btn.Position = UDim2.new(0, 3, 0, yPos)
        btn.BackgroundColor3 = (selectedFileName == name) and Color3.fromRGB(0, 120, 60) or Color3.fromRGB(30, 30, 40)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Text = "📁 " .. name
        btn.TextSize = 9
        btn.Font = Enum.Font.Gotham
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        
        btn.MouseButton1Click:Connect(function()
            selectedFileName = name
            StatusTxt.Text = "Selected: " + name -- fixed string concat below
            StatusTxt.Text = "Selected: " .. name
            -- Reset playback on new selection
            isPlaying = false
            isPaused = false
            currentIndex = 1
            PlayBtn.Text = "▶️ Play"
            PlayBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 160)
            updateFileList()
        end)
        
        yPos = yPos + 30
    end
    MacroListFrame.CanvasSize = UDim2.new(0, 0, 0, yPos)
end

-- Record & Save to File
RecordBtn.MouseButton1Click:Connect(function()
    isRecording = not isRecording
    if isRecording then
        currentRecording = {}
        RecordBtn.Text = "🔴 Recording... (Click to Stop & Save)"
        RecordBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        StatusTxt.Text = "Status: Recording..."
        
        recordConn = RunService.Heartbeat:Connect(function()
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local cf = char.HumanoidRootPart.CFrame
                    table.insert(currentRecording, {cf:GetComponents()})
                end
            end)
        end)
    else
        if recordConn then recordConn:Disconnect() end
        RecordBtn.Text = "🔴 Record & Save to File"
        RecordBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        
        local macroName = NameBox.Text
        if macroName == "" or macroName == "Enter Macro Name..." then
            macroName = "Macro_" .. (os.time() % 1000)
        end
        
        if #currentRecording > 0 and writefile then
            pcall(function()
                local encoded = HttpService:JSONEncode(currentRecording)
                writefile(FolderName .. "/" .. macroName .. ".json", encoded)
                selectedFileName = macroName
                StatusTxt.Text = "Permanently saved '" .. macroName .. "'!"
                updateFileList()
            end)
        else
            StatusTxt.Text = "Status: Empty or writefile not supported!"
        end
    end
end)

-- Delete Selected File Action
DeleteBtn.MouseButton1Click:Connect(function()
    if not selectedFileName or not delfile then
        StatusTxt.Text = "Status: No file selected!"
        return
    end
    
    pcall(function()
        delfile(FolderName .. "/" .. selectedFileName .. ".json")
        StatusTxt.Text = "Deleted file '" .. selectedFileName .. "'!"
        selectedFileName = nil
        isPlaying = false
        isPaused = false
        PlayBtn.Text = "▶️ Play"
        PlayBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 160)
        updateFileList()
    end)
end)

-- Play / Pause / Resume Logic
PlayBtn.MouseButton1Click:Connect(function()
    if not selectedFileName or not readfile then
        StatusTxt.Text = "Status: Please select a file first!"
        return
    end

    -- Case 1: If currently playing -> Switch to Pause
    if isPlaying and not isPaused then
        isPaused = true
        PlayBtn.Text = "▶️ Resume"
        PlayBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 0)
        StatusTxt.Text = "Status: Paused at frame " .. currentIndex
        return
    end

    -- Case 2: If currently paused -> Switch to Resume (Continue playing from currentIndex)
    if isPlaying and isPaused then
        isPaused = false
        PlayBtn.Text = "⏸️ Pause"
        PlayBtn.BackgroundColor3 = Color3.fromRGB(160, 90, 0)
        StatusTxt.Text = "Status: Resumed playing..."
        return
    end

    -- Case 3: Start fresh playback
    local filePath = FolderName .. "/" .. selectedFileName .. ".json"
    if not pcall(function() readfile(filePath) end) then
        StatusTxt.Text = "Status: File not found!"
        return
    end

    pcall(function()
        loadedPath = HttpService:JSONDecode(readfile(filePath))
    end)

    if not loadedPath or #loadedPath == 0 then
        StatusTxt.Text = "Status: Macro file is empty!"
        return
    end

    isPlaying = true
    isPaused = false
    currentIndex = 1
    PlayBtn.Text = "⏸️ Pause"
    PlayBtn.BackgroundColor3 = Color3.fromRGB(160, 90, 0)
    StatusTxt.Text = "Status: Playing '" .. selectedFileName .. "'..."

    task.spawn(function()
        pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then 
                isPlaying = false
                PlayBtn.Text = "▶️ Play"
                PlayBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 160)
                return 
            end
            local hrp = char.HumanoidRootPart
            
            while currentIndex <= #loadedPath do
                -- Check if paused
                while isPaused do
                    task.wait(0.1)
                    if not isPlaying then break end
                end

                if not isPlaying or not hrp.Parent then break end

                local step = 1
                if playSpeed == 2 then step = 2
                elseif playSpeed == 3 then step = 3 end

                hrp.CFrame = CFrame.new(unpack(loadedPath[currentIndex]))
                currentIndex = currentIndex + step
                
                task.wait(0.03 / playSpeed)
            end

            isPlaying = false
            isPaused = false
            currentIndex = 1
            PlayBtn.Text = "▶️ Play"
            PlayBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 160)
            StatusTxt.Text = "Status: Playback finished!"
        end)
    end)
end)

